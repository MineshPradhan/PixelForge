{
  "name": "pixelforge",
  "version": "1.0.2",
  "description": "PixelForge — Professional Photoshop Alternative for macOS, Windows & Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node -e \"const fs = require('fs'), { execSync } = require('child_process'); fs.readdirSync('.').filter(f => f.startsWith('test-') && f.endsWith('.js')).sort().forEach(f => { console.log('\\n[TEST SUITE] ' + f); execSync('node ' + f, { stdio: 'inherit' }); });\""
  },
  "build": {
    "appId": "com.pixelforge.studio",
    "productName": "PixelForge Studio",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz",
        "deb"
      ],
      "category": "Graphics",
      "icon": "assets/icon.png",
      "synopsis": "Professional Photoshop Alternative for Linux & Windows",
      "description": "PixelForge Studio is a professional digital photo editing, retouching, and graphic compositing suite with Photoshop parity.",
      "maintainer": "Minesh Pradhan <mineshpradhan2002@gmail.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "minimumSystemVersion": "10.15.0"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "keywords": [
    "photoshop",
    "image-editor",
    "canvas",
    "layers",
    "electron",
    "windows"
  ],
  "author": {
    "name": "Minesh Pradhan",
    "email": "mineshpradhan2002@gmail.com",
    "url": "https://github.com/MineshPradhan"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
